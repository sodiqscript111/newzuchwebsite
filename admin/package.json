{
  "name": "zuch-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/main.ts",
    "seed": "tsx --env-file-if-exists=.env server/seed.ts",
    "typecheck": "tsc --noEmit",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "preview:export": "node scripts/export-preview.mjs",
    "build:preview": "vite build --mode preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@effect/platform-node": "^4.1.2",
    "@effect/sql-libsql": "^4.1.2",
    "@libsql/client": "^0.18.0",
    "effect": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
