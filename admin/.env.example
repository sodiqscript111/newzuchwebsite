# Everything here is optional on your own computer. With nothing set, the admin
# uses a database file and a photo folder inside admin/data.

# Database. Leave unset for the local file; use a Turso database when deployed.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Photos. Set all of these to store new photos in S3-compatible storage (Brimble).
# S3_ENDPOINT=https://t3.storage.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=

# PORT=4320
# DATA_DIR=data
