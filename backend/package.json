{
  "name": "zuch-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:sites && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:sites": "node scripts/build-sites.mjs",
    "db:migrate:local": "wrangler d1 migrations apply zuch --local",
    "db:migrate:remote": "wrangler d1 migrations apply zuch --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0"
  }
}
