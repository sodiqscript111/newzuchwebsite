# Copy to .dev.vars for `npm run dev`. .dev.vars is never committed.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8787
ADMIN_PASSWORD=change-me-locally

# Leave PAYSTACK_SECRET_KEY empty to use the pretend checkout at /api/dev/checkout.
# With a test key (sk_test_...), real Paystack test payments work locally too.
PAYSTACK_SECRET_KEY=
# The webhook signing secret (whsec_...) from Developers > API configuration, if you have one.
PAYSTACK_WEBHOOK_SECRET=

# Leave empty locally to skip sending emails.
RESEND_API_KEY=
