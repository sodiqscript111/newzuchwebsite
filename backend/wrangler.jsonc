{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "zuch.com.ng", "custom_domain": true },
    { "pattern": "www.zuch.com.ng", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuch",
      "database_id": "26d8ff0c-e30f-4d84-bf7f-4a2d28a33dd8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zuch-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://zuch.com.ng",
    "EMAIL_FROM": "Zuch <orders@zuch.com.ng>",
    "OWNER_EMAIL": "Zuchstitches@gmail.com",
    "BAYSE_URL": "https://relay.bayse.markets"
  }
}
